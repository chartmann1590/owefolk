    <!-- Privacy Policy screen -->
    <string name="privacy_title">Privacy policy</string>
    <string name="privacy_back">Back</string>
    <string name="privacy_updated">Last updated August 18, 2026. Owefolk is published by Hartmann Studios.</string>
    <string name="privacy_intro">This policy explains what the app stores, what stays on your device, and the controls you have over your data.</string>
    <string name="privacy_data_title">Data we use</string>
    <string name="privacy_data_1">Owefolk stores your account profile, group memberships, expenses, split allocations, settlements you report, payment preference, device notification tokens, and app settings.</string>
    <string name="privacy_data_2">Your payment preference and handle are shared with members of your groups so the person who owes you can use your selected repayment method. They are not public outside those groups.</string>
    <string name="privacy_firebase_title">Firebase services</string>
    <string name="privacy_firebase_1">We use Firebase Authentication, Cloud Firestore, App Check, Crashlytics, Performance Monitoring, Remote Config, and Google Analytics for Firebase.</string>
    <string name="privacy_firebase_2">Diagnostic and analytics events are designed not to include expense amounts, notes, names, email addresses, payment handles, invite tokens, or group identifiers. You can turn diagnostic and analytics collection off from this Profile screen.</string>
    <string name="privacy_receipts_title">Receipt scanning</string>
    <string name="privacy_receipts_1">Receipt images are processed on your device with Google ML Kit text recognition. Owefolk uses the recognized text only to suggest a merchant and total for your review. Receipt images and full recognized text are not uploaded to Owefolk, Firebase, or analytics.</string>
    <string name="privacy_ads_title">Advertising</string>
    <string name="privacy_ads_1">Owefolk uses Google AdMob for banner and occasional interstitial advertising. The Google User Messaging Platform requests consent where required and provides an in-app privacy choices entry point when applicable. Google may process device identifiers and ad interaction data according to your consent choices and Google\'s policies.</string>
    <string name="privacy_cloudflare_title">Cloudflare services</string>
    <string name="privacy_cloudflare_1">Cloudflare Workers and D1 receive web-based account deletion requests. The email and optional details are encrypted with AES-GCM before storage; only a keyed digest is retained for duplicate detection.</string>
    <string name="privacy_external_title">External payment services</string>
    <string name="privacy_external_1">Owefolk opens external services such as Venmo, Cash App, PayPal, or Zelle. Owefolk does not process, hold, or verify those payments. Your use of those services is governed by their own terms and privacy policies.</string>
    <string name="privacy_deletion_title">Deletion and retention</string>
    <string name="privacy_deletion_1">You can request deletion in this app. We delete your profile, credentials, notification tokens, and payment handles. Shared ledger records needed by remaining group members are retained without your personal profile and display "Deleted member".</string>
    <string name="privacy_choices_title">Your choices</string>
    <string name="privacy_choices_1">Turn off diagnostic and analytics collection: Profile &gt; Privacy-safe diagnostics.</string>
    <string name="privacy_choices_2">Control advertising consent: Google\'s consent prompt and the in-app privacy choices entry point.</string>
    <string name="privacy_choices_3">Delete your account: Profile &gt; Delete account.</string>
    <string name="privacy_contact_title">Contact</string>
    <string name="privacy_contact_1">For privacy questions, open a private account deletion request or contact the publisher through the Owefolk support tracker on GitHub.</string>

